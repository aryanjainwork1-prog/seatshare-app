# SeatShare Environment Variables

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/seatshare

# JWT signing secret (HS256)
SESSION_SECRET=your-super-secret-key-change-in-production

# Node environment (development | production)
NODE_ENV=development

# API server port (assigned by workflow, but can be overridden)
# PORT=5000

# Base path for API routing (assigned by workflow)
# BASE_PATH=/api
